# Monad networks (leads from prior research — verified live in Phase 0)
RPC_URL_TESTNET=https://testnet-rpc.monad.xyz   # chain id 10143 (0x279f)
RPC_URL_MAINNET=https://rpc.monad.xyz           # chain id 143   (0x8f)

# Funded testnet wallets (public addresses documented in README).
# Put the actual private keys here locally; NEVER commit the real .env.
PRIVATE_KEY_DEPLOYER=0x...   # DEPLOYER / ISSUER : 0xa34118bD1A2A789A962A4471C59c3964fb716123
PRIVATE_KEY_MM=0x...         # MM (operator)     : 0x687dFEcC7eAaFA4DC28f72Bfb9cdB77cAe18a641
PRIVATE_KEY_TAKER=0x...      # TAKER             : 0x7A0A94615094Ef0673f2D0F031D43fB9ED78cc0B
PRIVATE_KEY_ATTACKER=0x...   # ATTACKER          : 0x6d11172f538b60BE3a69c745944767Ac94019df7

# --- services (Day 3) ---
PRIVATE_KEY_KEEPER=0x...   # keeper's own wallet (own nonce)
PRIVATE_KEY_FAUCET=0x...   # faucet wallet (testnet)
PRIVATE_KEY_SEEDER=0x...   # may reuse PRIVATE_KEY_DEPLOYER
DB_PATH=./covenant.db
PORT=8080
# module toggles (indexer+api default on; others opt-in)
RUN_KEEPER=false
RUN_FAUCET=false
RUN_SEEDER=false
RUN_MM_BOT=false
MM_BOT_MODE=honest
RUN_TAKER_BOT=false
