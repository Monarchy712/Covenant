# Monad networks (leads from prior research — verified live in Phase 0)
RPC_URL_TESTNET=https://testnet-rpc.monad.xyz   # chain id 10143 (0x279f)
RPC_URL_MAINNET=https://rpc.monad.xyz           # chain id 143   (0x8f)

# Funded testnet wallets (public addresses documented in README).
# Put the actual private keys here locally; NEVER commit the real .env.
PRIVATE_KEY_DEPLOYER=0x...   # DEPLOYER / ISSUER : 0xa34118bD1A2A789A962A4471C59c3964fb716123
PRIVATE_KEY_MM=0x...         # MM (operator)     : 0x687dFEcC7eAaFA4DC28f72Bfb9cdB77cAe18a641
PRIVATE_KEY_TAKER=0x...      # TAKER             : 0x7A0A94615094Ef0673f2D0F031D43fB9ED78cc0B
PRIVATE_KEY_ATTACKER=0x...   # ATTACKER          : 0x6d11172f538b60BE3a69c745944767Ac94019df7

# --- services ---
# WALLET SEPARATION (Part 1): every RUNNING module needs its OWN key. The startup check
# refuses to boot if two enabled modules share an address. FAUCET must be dedicated (NOT
# DEPLOYER). SEEDER may reuse DEPLOYER. ATTACKER/DEPLOYER are not used by any service
# (DEPLOYER is only the topup source and the demo-issuer fallback).
PRIVATE_KEY_KEEPER=0x...       # keeper's own wallet (own nonce)
PRIVATE_KEY_FAUCET=0x...       # DEDICATED faucet wallet (must differ from DEPLOYER/SEEDER)
PRIVATE_KEY_SEEDER=0x...       # seeder; may reuse PRIVATE_KEY_DEPLOYER
PRIVATE_KEY_DEMO_ISSUER=0x...  # optional; demo-session mandate creator (falls back to SEEDER)

# TREASURY (central MON funding; replaces the old DEPLOYER topup). The ONLY wallet that funds
# the others. Nothing else ever sends from it (own nonce). Testnet-only key.
PRIVATE_KEY_TREASURY=         # treasury wallet key (dedicated; must differ from every service wallet)

DB_PATH=./covenant.db          # in production point this at a MOUNTED volume, e.g. /data/covenant.db
PORT=8080

# Persistence guard: refuse to start if DB_PATH isn't on a mounted volume (so the DB is never on
# ephemeral storage that's wiped on redeploy). Defaults ON when NODE_ENV=production. Set to false
# ONLY to override a wrong detection for your host.
REQUIRE_DB_VOLUME=             # true | false (default: true in production)

# Historical backfill (POST /admin/backfill {fromBlock,toBlock}) — fills a gap WITHOUT touching
# the forward indexer. Defaults are conservative to stay gentle on the public RPC.
BACKFILL_SPAN=3000             # blocks per outer step
BACKFILL_CONCURRENCY=6         # parallel getLogs windows for the backfill (lower than the forward indexer)
BACKFILL_PAUSE_MS=250          # breather between steps

# module toggles (indexer+api default on; others opt-in)
RUN_KEEPER=false
RUN_FAUCET=false
RUN_SEEDER=false
RUN_MM_BOT=false           # reference MM bot (quotes one fixed vault; honest|malicious)
MM_BOT_MODE=honest         # honest | malicious
RUN_TAKER_BOT=false
RUN_HOUSE_MM=false         # house MM: auto-accepts invited mandates + quotes honestly (uses PRIVATE_KEY_MM)
RUN_TREASURY=              # true = hosted auto-top-up loop keeps service wallets funded from the treasury

# treasury safety limits + targets (optional; sensible defaults in config)
# TREASURY_MAX_PER_TRANSFER_MON=10    # cap per single transfer
# TREASURY_MAX_PER_DAY_MON=60         # cap on total sent per rolling 24h
# TREASURY_MIN_RESERVE_MON=2          # the treasury never spends below this (own gas + reserve)
# TREASURY_LOW_WARN_MON=15            # /health warns + goes "degraded" below this (time to refill)
# TREASURY_TOPUP_INTERVAL_MS=180000   # hosted auto-top-up cadence (3 min)
# TREASURY_QA_BURNER_TARGET_MON=5     # CLI topup-all only; QA burner from .secrets/burner.key
# QA_BURNER_ADDRESS=0x...             # override the QA burner address for treasury:topup-all

# public-surface hardening
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; add the Vercel domain later
ADMIN_TOKEN=                            # required for admin endpoints (demo:reset, topup)
