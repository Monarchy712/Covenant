# Covenant web app — environment (set these in Vercel Project Settings → Environment Variables)

# Hosted backend API (Railway). Defaults to this if unset.
NEXT_PUBLIC_API_URL=https://covenantservices-production.up.railway.app

# Monad testnet RPC (chain 10143). Defaults to the public RPC if unset.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: WalletConnect Cloud projectId to enable WalletConnect-based wallets.
# Left blank by design — injected (MetaMask) + the in-browser demo wallet work without it.
NEXT_PUBLIC_WC_PROJECT_ID=
