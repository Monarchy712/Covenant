# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Dotenv file
.env
.env.*
!.env.example

# services
node_modules/
*.db
*.db-wal
*.db-shm
dist/
services/covenant.db*

# Next.js build output (apps/web)
.next/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo

# playwright-cli / playwright test artifacts (skill runtime; browsers live in ~/.cache/ms-playwright)
.playwright-cli/
test-results/
playwright-report/

# Local testnet burner keys (never committed)
.secrets/
